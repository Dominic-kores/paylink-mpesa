PORT=5000

# PostgreSQL database
DATABASE_URL="postgresql://postgres:password@localhost:5432/paylink?schema=public"

# Frontend
FRONTEND_URL=http://localhost:5173

# Dashboard security
JWT_SECRET=replace_with_random_secret_at_least_32_chars
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# Daraja Sandbox
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_consumer_key
DARAJA_CONSUMER_SECRET=your_consumer_secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your_sandbox_passkey

# Backend public URL
BACKEND_PUBLIC_URL=https://your-ngrok-domain.ngrok-free.app

# Private callback token
MPESA_CALLBACK_TOKEN=replace_with_random_48_character_hex_token

# ---------------- PayLink v2 ----------------

# Merchant details (shown on receipts; merchant SMS goes here)
MERCHANT_NAME="Your Business Name"
MERCHANT_PHONE=0712345678

# Resend email receipts (optional; skipped if unset)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="PayLink <receipts@your-verified-domain.com>"

# Africa's Talking SMS (optional; skipped if unset)
# Use AT_USERNAME=sandbox with your sandbox API key
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=
